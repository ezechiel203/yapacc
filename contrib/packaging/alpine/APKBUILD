# Contributor: Alexandre BETRY <ezechiel203@users.noreply.github.com>
# Maintainer: Alexandre BETRY <ezechiel203@users.noreply.github.com>
#
# yapacc for Alpine Linux: the core only, without optional features.
# /usr/bin/yapacc, the manual page and shell completions; no component,
# no service, no hook.

pkgname=yapacc
pkgver=0.1.0
pkgrel=0
pkgdesc="Optional companion to the native package manager: source resolution, provenance, gated changes"
url="https://github.com/ezechiel203/yapacc"
arch="all"
license="GPL-2.0-only"
makedepends="cargo"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
# The source tarball is the release asset of that name (git archive of the
# tag); it unpacks to $pkgname-$pkgver.
source="$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
# net: cargo fetch in prepare()
options="net"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo build --frozen --release --no-default-features --bin yapacc
}

check() {
	# Some tests reach for the network; they are written to tolerate its
	# absence. The tests are built in the dev profile, so they do not
	# replace the release binary that package() installs.
	cargo test --frozen --no-default-features
}

package() {
	install -Dm755 target/release/yapacc "$pkgdir"/usr/bin/yapacc
	install -Dm644 contrib/man/yapacc.1 "$pkgdir"/usr/share/man/man1/yapacc.1

	# Completions come from the binary that was just built (this assumes a
	# native build; abuild's -doc and -*-completion subpackages pick the
	# files up by their paths).
	mkdir -p "$pkgdir"/usr/share/bash-completion/completions \
		"$pkgdir"/usr/share/zsh/site-functions \
		"$pkgdir"/usr/share/fish/vendor_completions.d
	target/release/yapacc completions bash \
		> "$pkgdir"/usr/share/bash-completion/completions/yapacc
	target/release/yapacc completions zsh \
		> "$pkgdir"/usr/share/zsh/site-functions/_yapacc
	target/release/yapacc completions fish \
		> "$pkgdir"/usr/share/fish/vendor_completions.d/yapacc.fish
}

# Filled in by contrib/packaging/fill-release.sh (or `abuild checksum`).
sha512sums=""
